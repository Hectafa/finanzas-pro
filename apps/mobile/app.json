{
  "expo": {
    "name": "Finanzas Pro",
    "slug": "finanzas-pro",
    "version": "0.1.0",
    "scheme": "finanzaspro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finanzaspro.app"
    },
    "android": {
      "package": "com.finanzaspro.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finanzas Pro usa tus fotos para adjuntar comprobantes a los movimientos.",
          "cameraPermission": "Finanzas Pro usa la cámara para fotografiar comprobantes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
