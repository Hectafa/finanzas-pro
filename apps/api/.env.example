# Copia este archivo a .env (nunca subas .env al repositorio).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rol de la API (sujeto a seguridad por fila). Valores para la base de Docker local.
DATABASE_URL=postgresql://finanzas_app:finanzas_app_dev@localhost:5433/finanzas_dev
# Rol dueño del esquema: solo para migraciones y seed.
DATABASE_MIGRATION_URL=postgresql://finanzas_owner:finanzas_owner_dev@localhost:5433/finanzas_dev

# Base de pruebas automáticas (se borra en cada ejecución de pruebas).
TEST_DATABASE_URL=postgresql://finanzas_app:finanzas_app_dev@localhost:5433/finanzas_test
TEST_DATABASE_MIGRATION_URL=postgresql://finanzas_owner:finanzas_owner_dev@localhost:5433/finanzas_test

# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Enlaces que se envían por correo (deep link de la app).
APP_LINK_BASE=finanzaspro://
# Versión web (computadora). Si se define, los correos incluyen también su enlace. En local: http://localhost:8081
APP_WEB_URL=http://localhost:8081

# Correo: file (escribe en apps/api/.mail/), memory (pruebas) o resend.
MAIL_DRIVER=file
MAIL_FROM=Finanzas Pro <no-reply@example.com>
RESEND_API_KEY=

# Orígenes permitidos para CORS (separados por coma). La app móvil no lo necesita; la versión web sí.
CORS_ORIGINS=http://localhost:8081
# Documentación Swagger en /docs
DOCS_ENABLED=true
# Solicitudes por minuto por IP (las rutas de autenticación tienen un límite menor).
THROTTLE_LIMIT=120
