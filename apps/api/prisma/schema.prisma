// Esquema de la Fase 1: identidad, empresas, roles, permisos y auditoría.
// Convenciones: UUID v7 generados por la aplicación, tablas y columnas en snake_case,
// toda entidad de empresa lleva company_id y está protegida por RLS (ver migración init).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id                String              @id @db.Uuid
  email             String              @unique @db.VarChar(254)
  passwordHash      String              @map("password_hash")
  fullName          String              @map("full_name") @db.VarChar(120)
  status            UserStatus          @default(ACTIVE)
  emailVerifiedAt   DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount  Int                 @default(0) @map("failed_login_count")
  lockedUntil       DateTime?           @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime            @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  memberships       CompanyMembership[]
  resetTokens       PasswordResetToken[]

  @@map("users")
}

model Session {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceName    String?        @map("device_name") @db.VarChar(80)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?        @map("revoked_reason") @db.VarChar(40)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Company {
  id          String              @id @db.Uuid
  name        String              @db.VarChar(120)
  legalName   String?             @map("legal_name") @db.VarChar(200)
  taxId       String?             @map("tax_id") @db.VarChar(13)
  currency    String              @default("MXN") @db.Char(3)
  timeZone    String              @default("America/Mexico_City") @map("time_zone") @db.VarChar(64)
  isDemo      Boolean             @default(false) @map("is_demo")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String              @map("created_by") @db.Uuid
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?             @map("updated_by") @db.Uuid
  version     Int                 @default(1)
  branches    Branch[]
  memberships CompanyMembership[]
  roles       Role[]
  invitations Invitation[]

  @@map("companies")
}

model Branch {
  id         String    @id @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String    @db.VarChar(120)
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String    @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("branches")
}

model Permission {
  key         String           @id @db.VarChar(64)
  module      String           @db.VarChar(32)
  action      String           @db.VarChar(32)
  roles       RolePermission[]

  @@map("permissions")
}

/// company_id NULL = rol de sistema (Propietario, Administrador, Contador, Empleado).
model Role {
  id          String              @id @db.Uuid
  companyId   String?             @map("company_id") @db.Uuid
  key         String?             @db.VarChar(32)
  name        String              @db.VarChar(80)
  description String?             @db.VarChar(300)
  isSystem    Boolean             @default(false) @map("is_system")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?             @map("created_by") @db.Uuid
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz(3)
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships CompanyMembership[]
  invitations Invitation[]

  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key") @db.VarChar(64)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model CompanyMembership {
  id        String           @id @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?          @map("created_by") @db.Uuid
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?          @map("updated_by") @db.Uuid
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(3)
  version   Int              @default(1)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("company_memberships")
}

model Invitation {
  id         String           @id @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  email      String           @db.VarChar(254)
  roleId     String           @map("role_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedBy  String           @map("invited_by") @db.Uuid
  acceptedBy String?          @map("accepted_by") @db.Uuid
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("invitations")
}

/// Bitácora append-only. El rol de la API no tiene UPDATE/DELETE sobre esta tabla.
/// hash = sha256(prev_hash + contenido): cualquier alteración rompe la cadena.
model AuditLog {
  id          String   @id @db.Uuid
  seq         BigInt   @unique @default(autoincrement())
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  data        Json?
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  prevHash    String?  @map("prev_hash") @db.Char(64)
  hash        String   @db.Char(64)

  @@index([companyId, seq])
  @@index([actorUserId])
  @@map("audit_logs")
}
